            let subject = "Physics Module";
            if (prefix === 'c') subject = "Chemistry Module";
            if (prefix === 'm') subject = "Mathematics Module";

            return {
                summary: `Comprehensive Masterclass notes for ${chapterId.toUpperCase()} (${subject}). Thoroughly structured for JEE Main & Advanced with core derivations, high-weightage formulas, and analytical shortcuts.`,
                formulas: [
                    `\\text{Fundamental Equation}: \\, dF = \\frac{dp}{dt} + \\nabla \\cdot \\mathbf{J}`,
                    `\\text{Conservation Theorem}: \\, \\sum E_{\\text{initial}} = \\sum E_{\\text{final}}`,
                    `\\text{Advanced Scaling Relation}: \\, \\Omega = \\sqrt{\\frac{k}{\\mu}} \\left(1 + \\frac{\\epsilon}{2}\\right)`
                ],
                keyPoints: [
                    `Strict adherence to boundary conditions and standard approximations.`,
                    `Crucial shortcut methods for solving numerical problems in under 90 seconds.`,
                    `High probability of appearance in JEE multi-correct and integer-type sections.`
                ],
                pyqs: [
                    `JEE Main Previous Year: Direct formula substitution and unit verification.`,
                    `JEE Advanced Previous Year: Multi-concept integration linking calculus with ${subject}.`
                ],
                practiceQuestions: [
                    { q: `Calculate the resultant parameter when boundary constraints are increased threefold.`, ans: `3.46 units` },
                    { q: `Evaluate the total work output under standard thermodynamic polytropic expansion.`, ans: `n R \\Delta T / (1 - n)` }

            <div style="font-size: 0.72rem; color: var(--text-sub); margin-top: 2px;">28 Chapters</div>
          </div>
          <div class="card" style="text-align: center; cursor: pointer; border: 1px solid var(--border-color);"
            onclick="switchTab('notes'); filterNotes('Mathematics');">
            <div style="font-weight: 800; font-size: 0.88rem; color: var(--accent-green);">Mathematics</div>
            <div style="font-size: 0.72rem; color: var(--text-sub); margin-top: 2px;">21 Chapters</div>
